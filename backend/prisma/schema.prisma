generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Income {
  id              Int      @id @default(autoincrement())
  donorName       String
  donorPhone      String?
  donorAddress    String?
  category        String
  amount          Float
  paymentMode     String
  description     String?
  customFields    String?  // JSON stringified array of {name, value}
  proofImage      String?  // Image path or base64
  receiptNo        String?  // Shared receipt number or voucher number
  memberPaymentId  Int?     // Link to MemberPayment if synced
  memberId         Int?     // Link to Member if synced
  madrasaPaymentId Int?     // Link to MadrasaPayment if synced
  studentId        Int?     // Link to MadrasaStudent if synced
  date             DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Expense {
  id             Int      @id @default(autoincrement())
  purpose        String
  paidTo         String
  category       String
  amount         Float
  paymentMode    String
  description    String?
  customFields   String?  // JSON stringified array of {name, value}
  proofImage     String?  // Image path or base64
  receiptNo      String?  // Receipt or voucher number
  staffPaymentId Int?     // Link to StaffPayment if salary payout
  staffId        Int?     // Link to Staff if salary payout
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Member {
  id                   Int             @id @default(autoincrement())
  name                 String
  address              String?
  phone                String?         @default("")
  job                  String?
  division             String?         // Ward / Division / Area
  idNumber             String?         // Member / House ID number
  hasFamily            Boolean         @default(false)
  adultsCount          Int             @default(0)
  childrenCount        Int             @default(0)
  familyDetails        String?         // Notes on family members & ages (e.g. JSON or text)
  joiningDate          DateTime        @default(now())
  monthlyDonation      Float           @default(100.0)
  openingBalance       Float           @default(0.0) // Initial past due balance / arrears when registering member
  status               String          @default("Active") // Active or Inactive
  hasMadrasa           Boolean         @default(false)
  madrasaChildrenCount Int             @default(0)
  madrasaMonthlyFee    Float           @default(0.0)
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  payments        MemberPayment[]
  foodDuties      FoodDuty[]
  madrasaStudents MadrasaStudent[]
}

model MemberPayment {
  id                   Int      @id @default(autoincrement())
  memberId             Int
  member               Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month                Int      // 1-12 (or 0 for dedicated opening balance payment)
  year                 Int      // e.g. 2026
  membershipAmount     Float    @default(0.0)
  madrasaAmount        Float    @default(0.0)
  openingBalanceAmount Float    @default(0.0) // Amount paid towards past opening balance
  totalAmount          Float
  paymentMode          String   @default("Cash in Hand")
  paymentDate          DateTime @default(now())
  receiptNo            String?
  notes                String?
  createdAt            DateTime @default(now())
}

model Staff {
  id          Int            @id @default(autoincrement())
  name        String
  phone       String?        @default("")
  salary      Float
  category    String         // Imam, Muazzin, Cashier, Teacher (Madarsa), etc.
  joiningDate DateTime       @default(now())
  status      String         @default("Active") // Active, On Leave, Inactive
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  payments    StaffPayment[]
}

model StaffPayment {
  id          Int      @id @default(autoincrement())
  staffId     Int
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month       Int      // 1-12
  year        Int
  amount      Float
  paymentMode String   @default("Cash in Hand")
  paymentDate DateTime @default(now())
  receiptNo   String?
  notes       String?
  createdAt   DateTime @default(now())
}

model CustomCategory {
  id        Int      @id @default(autoincrement())
  type      String   // "INCOME" or "EXPENSE"
  name      String
  createdAt DateTime @default(now())

  @@unique([type, name])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model FoodDuty {
  id          Int      @id @default(autoincrement())
  memberId    Int?
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  customName  String?
  phone       String?
  division    String?
  date        DateTime
  mealType    String   @default("All Day") // "All Day", "Breakfast", "Lunch", "Dinner"
  status      String   @default("Pending") // "Pending", "Completed", "Swapped", "Cancelled"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MadrasaStudent {
  id             Int              @id @default(autoincrement())
  memberId       Int?             // Parent / Guardian Member link
  member         Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  parentName     String?          // Parent or Member Name
  parentPhone    String?          @default("")
  job            String?          // Parent / Member Job
  division       String?          // Ward / Division / Area
  studentsCount  Int              @default(1) // Number of children in madrasa
  studentName    String?          // Optional child name(s)
  admissionNo    String?          // Optional Roll / Admission No
  classLevel     String?          @default("") // Optional Class / Grade
  monthlyFee     Float            @default(200.0) // Total monthly madrasa fee
  feePerStudent  Float?           @default(200.0) // Rate per student
  openingBalance Float            @default(0.0) // Past fee arrears
  admissionDate  DateTime         @default(now()) // Joining / Admission date
  status         String           @default("Active") // Active or Inactive
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payments       MadrasaPayment[]
}

model MadrasaPayment {
  id                   Int            @id @default(autoincrement())
  studentId            Int
  student              MadrasaStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month                Int            // 1-12 (or 0 for opening balance payment)
  year                 Int            // e.g. 2026
  feeAmount            Float          @default(0.0)
  openingBalanceAmount Float          @default(0.0)
  totalAmount          Float
  paymentMode          String         @default("Cash in Hand")
  paymentDate          DateTime       @default(now())
  receiptNo            String?
  notes                String?
  createdAt            DateTime       @default(now())
}
