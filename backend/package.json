{
  "name": "mosque-backend",
  "version": "1.0.0",
  "description": "Backend API for Mosque Management System with Prisma and PostgreSQL / Supabase",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:deploy": "prisma db push --schema=prisma/schema.postgresql.prisma && prisma generate --schema=prisma/schema.postgresql.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "setup:prod": "npm run prisma:deploy && npm run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
