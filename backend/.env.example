PORT=5001
NODE_ENV=production

# Database URL
# For local SQLite:
# DATABASE_URL="file:./dev.db"

# For Neon PostgreSQL (Use Pooled connection with -pooler for serverless production):
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@ep-xyz-pooler.us-east-2.aws.neon.tech/Mosque?sslmode=require&pgbouncer=true&connect_timeout=15"

# Optional: Set to true only if on a paid Neon plan and want to prevent compute suspension
# DB_KEEP_ALIVE="false"

# For Supabase PostgreSQL (replace [YOUR_PASSWORD] and [YOUR_PROJECT_REF]):
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# JWT Secret - generate a strong random secret (e.g. openssl rand -base64 32)
JWT_SECRET="replace_with_a_long_random_secret_key"

# CORS Origin: Comma-separated list of allowed frontend domains or * (e.g. https://jamia-annoor.pages.dev)
CORS_ORIGIN="https://your-app.pages.dev"
